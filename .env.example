# Copy to .env and fill in. Real values never go in git.
# Defaults shown on commented lines are what the app uses when the variable is unset.

# --- Core (required) ---

# Tortoise DB URL.
DB_CONNECTION_STRING=postgres://user:pass@localhost:5432/ping
# Comma-separated browser origins allowed for CORS and the /ws handshake.
ALLOWED_ORIGINS=http://localhost:5173
# Secret (32+ bytes) that signs attachment download links. Unset or too short means a
# random key per start, so links break on restart. Required in production.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ATTACHMENT_URL_KEY=change-me-generate-32-plus-bytes
# true only for local http:// dev (Lax, non-Secure cookies). Must be false in production.
DEBUG=false

# --- CORS ---

# Regex for extra origins that can't be listed (Vercel previews). Empty disables it.
# Anchor it on the team slug, see DEPLOYMENT.md.
# ALLOWED_ORIGIN_REGEX=

# --- Voice (LiveKit): voice is off unless URL, key and secret are all set ---

LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
# Address the server calls LiveKit's API on. Default: LIVEKIT_URL with ws(s):// turned into http(s)://.
# LIVEKIT_API_URL=

# --- Web Push (VAPID): push is off unless all three are set ---
# Generate once with: python -m app.scripts.gen_vapid. Keep them stable.

VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com
# Extra push-service hosts allowed for subscriptions (comma-separated, suffix match).
# PUSH_EXTRA_HOSTS=

# --- Server creation ---

# open: anyone can create servers. waitlist: only platform admins can; others submit a request.
# Grant admin: python -m app.scripts.platform_admin <username> --grant
# SERVER_CREATION=open

# --- Storage ---

# Image uploads (avatars, server icons).
# MEDIA_ROOT=media
# MEDIA_BASE_URL=/media
# MEDIA_MOUNT_PATH=/media
# MAX_UPLOAD_BYTES=5242880
# Message attachments. Must not be served by nginx or the media mount.
# ATTACHMENTS_ROOT=attachments
# MAX_ATTACHMENT_BYTES=26214400
# Uploaded export zips and their unpacked bundles. Needs room for the largest export. Never served.
# IMPORTS_ROOT=imports
# Largest export zip. 0 turns imports off.
# IMPORT_MAX_BYTES=5368709120
# Largest unpacked bundle. Default: twice IMPORT_MAX_BYTES.
# IMPORT_MAX_UNPACKED_BYTES=
# Largest piece of an upload.
# IMPORT_CHUNK_BYTES=8388608

# --- Rate limits (slowapi "<count>/<period>") ---

# AUTH_RATE_LIMIT=10/minute
# INVITE_USE_RATE_LIMIT=20/minute
# CLIENT_ERROR_RATE_LIMIT=10/minute
# CLIENT_ERROR_GLOBAL_RATE_LIMIT=300/hour
# Shared with the Cloudflare Worker (its PROXY_KEY secret), so limits key on the real
# client address it sends. Unset: limits key on the connecting address.
# TRUSTED_PROXY_KEY=

# --- Logging ---

# LOG_LEVEL=INFO
# LOG_DIR=logs
# LOG_FILE=logs/app.log
# LOG_MAX_BYTES=10485760
# LOG_BACKUP_COUNT=5

# --- Gunicorn (deploy only) ---

GUNICORN_BIND=127.0.0.1:8000
# Must stay 1: live WebSocket connections are per process.
GUNICORN_WORKERS=1
# GUNICORN_LOGLEVEL=info

# --- Local dev only ---

# Build the schema from the models on startup. Throwaway DBs only; production uses Aerich.
# DB_GENERATE_SCHEMAS=false
