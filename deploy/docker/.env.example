# Copy to .env in the repository root. Keep it out of git.
# Use URL-safe values (letters, digits, - and _) for secrets: the password goes into a URL.
# Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Public hostname of this server. DNS must point here; ports 80 and 443 must be reachable.
DOMAIN=chat.example.com

# Browser origin(s) of the web client, comma-separated. Not DOMAIN: this stack serves only the API.
ALLOWED_ORIGINS=https://app.example.com

# Postgres password. The api gets DB_CONNECTION_STRING=postgres://ping:<password>@db:5432/ping.
POSTGRES_PASSWORD=
# Signs attachment download links. 32+ bytes.
ATTACHMENT_URL_KEY=
# Lets the app see real client addresses behind the proxy for rate limits.
TRUSTED_PROXY_KEY=

# LiveKit credentials. The api gets LIVEKIT_URL=wss://<DOMAIN>:7443 and talks to http://livekit:7880.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Web Push, optional. Generate with: docker compose run --rm api python -m app.scripts.gen_vapid
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
